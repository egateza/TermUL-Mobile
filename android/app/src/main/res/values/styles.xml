<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Induk AppCompat dibutuhkan local_auth (BiometricPrompt); tanpa itu crash di Android 8 ke bawah.
         Aplikasi hanya bertema gelap, jadi latar jendela selalu termul_ground. -->
    <style name="LaunchTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/termul_ground</item>
    </style>
</resources>